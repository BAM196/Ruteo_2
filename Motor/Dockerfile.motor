FROM python:3.12-slim

WORKDIR /repo/Motor

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    MOTOR_FUENTE=db \
    MPLBACKEND=Agg

EXPOSE 8001

CMD ["uvicorn", "motor.api:app", "--host", "0.0.0.0", "--port", "8001"]
